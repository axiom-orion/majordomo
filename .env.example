# Qwen Cloud (hackathon requirement) — create a key at qwencloud.com after
# claiming the $40 hackathon voucher with your registration email.
QWEN_API_KEY=
# Qwen Cloud OpenAI-compatible endpoint (DashScope international)
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

CHAT_MODEL=qwen3.7-plus
JUDGE_MODEL=qwen3.7-max
EMBED_MODEL=text-embedding-v4
EMBED_DIM=1024

# "qwen" (real) or "mock" (deterministic offline — full pipeline + tests run
# with zero API keys; same pattern as NexusVenue's hash backend)
LLM_BACKEND=mock

# SQLite for dev; swapped for ApsaraDB RDS on Alibaba Cloud deploy
MAJORDOMO_DB=data/majordomo.db
